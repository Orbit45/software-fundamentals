    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;Nombre : NICOLAS SEBASTIAN GARCIA MORAN&quot;" newline="True"/>
            <declare name="numero" type="Integer" array="False" size=""/>
            <output expression="&quot;Ingresa un n&#250;mero entero (positivo o negativo):&quot;" newline="True"/>
            <input variable="numero"/>
            <assign variable="numero" expression="Abs(Numero)"/>
            <if expression="Numero Mod 2 == 0">
                <then>
                    <output expression="&quot;El n&#250;mero &quot; &amp; Numero &amp; &quot; es PAR.&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;El n&#250;mero &quot; &amp; Numero &amp; &quot; es IMPAR.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
