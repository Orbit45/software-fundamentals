<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="condicional reto 2"/>
        <attribute name="authors" value="NIKO"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-11-21 10:59:57 PM"/>
        <attribute name="created" value="TklLTztERVNLVE9QLUpEMFA5Tk07MjAyNS0xMS0yMTswOTo1NTo1MSBQTTsyNjUz"/>
        <attribute name="edited" value="TklLTztERVNLVE9QLUpEMFA5Tk07MjAyNS0xMS0yMTsxMDo1OTo1NyBQTTsyOzI3NjQ="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;Nicolas Garcia Moran&quot;" newline="True"/>
            <declare name="numero" type="Integer" array="False" size=""/>
            <output expression="&quot;Ingresa un numero entero, positivo o negativo :&quot;" newline="True"/>
            <input variable="numero"/>
            <if expression="numero &gt;= 0">
                <then>
                    <if expression="Numero == 0">
                        <then>
                            <output expression="&quot;El nnmero es CERO.&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="numero MOD 2 == 0">
                                <then>
                                    <output expression="&quot;El numero &quot; &amp; numero &amp; &quot; es par POSITIVO.&quot;" newline="True"/>
                                </then>
                                <else>
                                    <output expression="&quot;El numero &quot; &amp; numero &amp; &quot; es impar POSITIVO.&quot;" newline="True"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </then>
                <else>
                    <if expression="ABS(Numero) MOD 2 == 0">
                        <then>
                            <output expression="&quot;El numero &quot; &amp; numero &amp; &quot; es par NEGATIVO.&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;El numero &quot; &amp; numero &amp; &quot; es impar NEGATIVO.&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
