    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="resultadoDado" type="Integer" array="False" size=""/>
            <assign variable="resultadoDado" expression="Random(6) + 1"/>
            <output expression="&quot;El dado cayo en: &quot; &amp; resultadoDado" newline="True"/>
            <if expression="resultadoDado Mod 2 == 0">
                <then>
                    <output expression="&quot;El n&#250;mero es Par&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;El n&#250;mero es Impar.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
