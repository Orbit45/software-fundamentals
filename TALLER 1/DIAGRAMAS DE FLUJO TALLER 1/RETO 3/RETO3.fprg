<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="RETO3"/>
        <attribute name="authors" value="NIKO"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-11-24 09:52:52 PM"/>
        <attribute name="created" value="TklLTztERVNLVE9QLUpEMFA5Tk07MjAyNS0xMS0yNDswOToyMzo1NCBQTTsyNjU0"/>
        <attribute name="edited" value="TklLTztERVNLVE9QLUpEMFA5Tk07MjAyNS0xMS0yNDswOTo1Mjo1MiBQTTsxOzI3NjI="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;Nombre : Nicolas Sebastian Garcia Moran&quot;" newline="True"/>
            <declare name="numLanzamientos" type="Integer" array="False" size=""/>
            <declare name="contador" type="Integer" array="False" size=""/>
            <declare name="resultadoDado" type="Integer" array="False" size=""/>
            <declare name="conteo1" type="Integer" array="False" size=""/>
            <declare name="conteo2" type="Integer" array="False" size=""/>
            <declare name="conteo3" type="Integer" array="False" size=""/>
            <declare name="conteo4" type="Integer" array="False" size=""/>
            <declare name="conteo5" type="Integer" array="False" size=""/>
            <declare name="conteo6" type="Integer" array="False" size=""/>
            <assign variable="conteo1" expression="0"/>
            <assign variable="conteo2" expression="0"/>
            <assign variable="conteo3" expression="0"/>
            <assign variable="conteo4" expression="0"/>
            <assign variable="conteo5" expression="0"/>
            <assign variable="conteo6" expression="0"/>
            <output expression="&quot;Ingrese el n&#250;mero de veces que desea lanzar el dado:&quot;" newline="True"/>
            <input variable="numLanzamientos"/>
            <for variable="contador" start="1" end="numLanzamientos" direction="inc" step="1">
                <assign variable="resultadoDado" expression="random(6) + 1"/>
                <if expression="resultadoDado == 1">
                    <then>
                        <assign variable="conteo1" expression="conteo1 + 1"/>
                    </then>
                    <else>
                        <if expression="resultadoDado == 2">
                            <then>
                                <assign variable="conteo2" expression="conteo2 + 1"/>
                            </then>
                            <else>
                                <if expression="resultadoDado == 3">
                                    <then>
                                        <assign variable="conteo3" expression="conteo3 + 1"/>
                                    </then>
                                    <else>
                                        <if expression="resultadoDado == 4">
                                            <then>
                                                <assign variable="conteo4" expression="conteo4 + 1"/>
                                            </then>
                                            <else>
                                                <if expression="resultadoDado == 5">
                                                    <then>
                                                        <assign variable="conteo5" expression="conteo5 + 1"/>
                                                    </then>
                                                    <else>
                                                        <assign variable="conteo6" expression="conteo6 + 1"/>
                                                    </else>
                                                </if>
                                            </else>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
            </for>
            <output expression="&quot;El n&#250;mero 1 sali&#243;: &quot; &amp; conteo1 &amp; &quot; veces.&quot;" newline="True"/>
            <output expression="&quot;El n&#250;mero 2 sali&#243;: &quot; &amp; conteo2 &amp; &quot; veces.&quot;" newline="True"/>
            <output expression="&quot;El n&#250;mero 3 sali&#243;: &quot; &amp; conteo3 &amp; &quot; veces.&quot;" newline="True"/>
            <output expression="&quot;El n&#250;mero 4 sali&#243;: &quot; &amp; conteo4 &amp; &quot; veces.&quot;" newline="True"/>
            <output expression="&quot;El n&#250;mero 5 sali&#243;: &quot; &amp; conteo5 &amp; &quot; veces.&quot;" newline="True"/>
            <output expression="&quot;El n&#250;mero 6 sali&#243;: &quot; &amp; conteo6 &amp; &quot; veces.&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
